# Copy to .env for local use (the app does NOT auto-load .env — export vars or
# run:  export $(grep -v '^#' .env | xargs)  then  uvicorn app.main:app ...
# On Render these live in the service's Environment tab (or render.yaml).

# SQLite is the zero-setup default. On Render this file is EPHEMERAL: it is
# wiped on every redeploy, restart and free-tier spin-down. For durable data set
# DATABASE_URL to a Postgres URL (Render Free Postgres, or Neon/Supabase free):
#   DATABASE_URL=postgresql://user:pass@dpg-xxxx-a-frankfurt.render.com/logsearch
DATABASE_URL=sqlite:///./logs.db

# Upload cap enforced in-process (app/routers/upload.py)
MAX_UPLOAD_MB=5

# "*" is fine for the single-service deploy (UI and API share one origin).
# Set to an explicit origin if you later host frontend/ elsewhere (Vercel).
CORS_ORIGIN=*

# Only used by `python -m app.seed`-style tooling; Render injects PORT itself
# and the start command must use $PORT, not this default.
PORT=8000

# Seed the demo dataset at startup when the database is empty.
# Defaults to on under Render (RENDER env var is set), off locally/in tests.
# SEED_ON_START=true

# If using a Render persistent disk (paid plans only) mount it at /var/data and
# note the FOUR slashes — sqlite absolute paths use sqlite:////abs/path:
# DATABASE_URL=sqlite:////var/data/logs.db
